# --- a terminal ------------------------------------------------------------------------------------
# The loop a `run -it` or an `exec -it` turns into. It runs on the pseudo-terminal the service
# allocated, so `stty size` reads the real window size — which is how a resize frame is proved to
# have reached the child as SIGWINCH.
terminal() {
  # The trap is the point: the kernel sends SIGWINCH to the foreground process group of the
  # terminal's session, which this is only because `setsid --ctty` put it there.
  #
  # IT SETS A FLAG, AND THE FLAG IS WHAT THE LOOP READS — not the exit status. This used to say "a
  # read interrupted by a signal returns above 128; anything else is end of input", which is bash's
  # behaviour and NOT dash's: measured on this host, dash's `read` answers 1 for BOTH end of input
  # and a read a trapped signal interrupted, so the status cannot tell them apart. What that cost
  # was a session that ended silently on the line after every resize — with the new size already
  # printed, so a test that waits for the size and then stops still passes. TerminalSocketTest's
  # resize test did exactly that and never noticed; the userflow story that types again afterwards
  # is what found it. The flag can tell them apart, in every shell.
  resized=0
  winch() {
    resized=1
    stty size
  }
  trap winch WINCH
  printf 'fake-terminal ready\r\n'
  while :; do
    if IFS= read -r line; then
      case "$line" in
        exit) printf 'bye\r\n'; exit 0 ;;
        crash) exit 3 ;;
        *) printf 'echo:%s\r\n' "$line" ;;
      esac
    elif [ "$resized" = 1 ]; then
      # The read was interrupted by the resize above, not ended: keep the session.
      resized=0
    else
      exit 0
    fi
  done
}

